      ],
      "scm/title": [
        {
          "command": "sidekick.reviewChanges",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "sidekick.generatePrDescription",
          "group": "navigation",
          "when": "scmProvider == git"
        },
        {
          "command": "sidekick.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git && config.sidekick.showCommitButton"
        }
      ],
      "editor/context": [
        {
          "submenu": "sidekick.menu",
          "group": "1_sidekick@1",
          "when": "editorTextFocus"
        }
      ],
      "sidekick.menu": [
        {
          "command": "sidekick.inlineChat",
          "group": "0_ask@1",
          "when": "editorTextFocus"
        },
        {
          "command": "sidekick.addKnowledgeNote",
          "group": "0_ask@2",
          "when": "editorTextFocus"
        },
        {
          "command": "sidekick.generateDocs",
          "group": "1_docs@1",
          "when": "editorTextFocus"
        },
        {
          "submenu": "sidekick.explainSubmenu",
          "group": "2_explain@1",
          "when": "editorHasSelection"
        },
        {
          "submenu": "sidekick.explainErrorSubmenu",
          "group": "2_explain@2",
          "when": "editorHasSelection"
        },
        {
          "command": "sidekick.fixError",
          "group": "2_explain@3",
          "when": "editorHasSelection"
        },
        {
          "command": "sidekick.transform",
          "group": "3_transform@1",
          "when": "editorHasSelection"
        }
      ],
      "sidekick.explainSubmenu": [
        {
          "command": "sidekick.explainCode.eli5",
          "group": "1_levels@1"
        },
        {
          "command": "sidekick.explainCode.curiousAmateur",
          "group": "1_levels@2"
        },
        {
          "command": "sidekick.explainCode.imposterSyndrome",
          "group": "1_levels@3"
        },
        {
          "command": "sidekick.explainCode.senior",
          "group": "1_levels@4"
        },
        {
          "command": "sidekick.explainCode.phd",
          "group": "1_levels@5"
        }
      ],
      "sidekick.explainErrorSubmenu": [
        {
          "command": "sidekick.explainError.eli5",
          "group": "1_levels@1"
        },
        {
          "command": "sidekick.explainError.curiousAmateur",
          "group": "1_levels@2"
        },
        {
          "command": "sidekick.explainError.imposterSyndrome",
          "group": "1_levels@3"
        },
        {
          "command": "sidekick.explainError.senior",
          "group": "1_levels@4"
        },
        {
          "command": "sidekick.explainError.phd",
          "group": "1_levels@5"
        }
      ],
      "view/title": [
        {
          "command": "sidekick.extractAssets",
          "when": "view == sidekick.dashboard",
          "group": "navigation@0"
        },
        {
          "command": "sidekick.dumpSession",
          "when": "view == sidekick.dashboard",
          "group": "navigation"
        },
        {
          "command": "sidekick.generateReport",
          "when": "view == sidekick.dashboard",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sidekick.editKnowledgeNote",
          "when": "viewItem =~ /^knowledgeNote\\./",
          "group": "1_manage@1"
        },
        {
          "command": "sidekick.confirmKnowledgeNote",
          "when": "viewItem == knowledgeNote.unconfirmed",
          "group": "1_manage@2"
        },
        {
          "command": "sidekick.deleteKnowledgeNote",
          "when": "viewItem =~ /^knowledgeNote\\./",
          "group": "2_destructive@1"
        }
      ]
    },
