{
  "name": "sidekick-shared",
  "version": "0.26.0",
  "description": "Shared data access layer for Sidekick — readers, types, providers, credentials, quota",
  "keywords": [
    "claude-code",
    "codex-cli",
    "opencode",
    "session-monitor",
    "token-usage",
    "quota",
    "jsonl",
    "ai-coding-assistant",
    "agent-hub",
    "zod-schemas"
  ],
  "homepage": "https://cesarandreslopez.github.io/sidekick-agent-hub/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cesarandreslopez/sidekick-agent-hub",
    "directory": "sidekick-shared"
  },
  "bugs": {
    "url": "https://github.com/cesarandreslopez/sidekick-agent-hub/issues"
  },
  "author": {
    "name": "Cesar Andres Lopez",
    "email": "cesarandreslopez@gmail.com"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    },
    "./phrases": {
      "types": "./dist/phrases.d.ts",
      "import": "./dist/phrases.js",
      "require": "./dist/phrases.js",
      "default": "./dist/phrases.js"
    },
    "./modelContext": {
      "types": "./dist/modelContext.d.ts",
      "import": "./dist/modelContext.js",
      "require": "./dist/modelContext.js",
      "default": "./dist/modelContext.js"
    },
    "./modelInfo": {
      "types": "./dist/modelInfo.d.ts",
      "import": "./dist/modelInfo.js",
      "require": "./dist/modelInfo.js",
      "default": "./dist/modelInfo.js"
    },
    "./formatting": {
      "types": "./dist/formatting.d.ts",
      "import": "./dist/formatting.js",
      "require": "./dist/formatting.js",
      "default": "./dist/formatting.js"
    },
    "./statusline": {
      "types": "./dist/statusline/index.d.ts",
      "import": "./dist/statusline/index.js",
      "require": "./dist/statusline/index.js",
      "default": "./dist/statusline/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "dist/browser.d.ts"
      ],
      "node": [
        "dist/node.d.ts"
      ],
      "schemas": [
        "dist/schemas/index.d.ts"
      ],
      "phrases": [
        "dist/phrases.d.ts"
      ],
      "modelContext": [
        "dist/modelContext.d.ts"
      ],
      "modelInfo": [
        "dist/modelInfo.d.ts"
      ],
      "formatting": [
        "dist/formatting.d.ts"
      ],
      "statusline": [
        "dist/statusline/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --config ../prettier.config.cjs --ignore-path ../.prettierignore --write \"src/**/*.{ts,tsx,js,jsx,json,md,css,html,yml,yaml}\" \"*.{js,cjs,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --config ../prettier.config.cjs --ignore-path ../.prettierignore --check \"src/**/*.{ts,tsx,js,jsx,json,md,css,html,yml,yaml}\" \"*.{js,cjs,mjs,json,md,yml,yaml}\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "3.8.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.3.6"
  }
}
